#!/usr/bin/env python3
"""Native messaging host that opens URLs in Emacs eww."""
import json
import struct
import subprocess
import sys


def read_message():
    raw_length = sys.stdin.buffer.read(4)
    if len(raw_length) < 4:
        return None
    length = struct.unpack("<I", raw_length)[0]
    return json.loads(sys.stdin.buffer.read(length))


def send_message(message):
    encoded = json.dumps(message).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(encoded)))
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.flush()


def main():
    message = read_message()
    if not message or "url" not in message:
        send_message({"error": "No URL provided"})
        return
    url = message["url"].replace("\\", "\\\\").replace('"', '\\"')
    elisp = f'(progn (eww "{url}") (raise-frame))'
    try:
        result = subprocess.run(
            ["/opt/homebrew/bin/emacsclient", "-e", elisp],
            capture_output=True,
        )
        if result.returncode == 0:
            send_message({"success": True})
        else:
            send_message({"error": result.stderr.decode()})
    except FileNotFoundError:
        send_message({"error": "emacsclient not found"})


if __name__ == "__main__":
    main()
