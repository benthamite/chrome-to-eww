#!/usr/bin/env python3
"""Native messaging host that opens URLs in Emacs eww."""
import json
import os
import shutil
import struct
import subprocess
import sys

_emacsclient = None


def find_emacsclient():
    global _emacsclient
    if _emacsclient is not None:
        return _emacsclient
    candidates = [
        "/opt/homebrew/bin/emacsclient",
        "/usr/local/bin/emacsclient",
        "/usr/bin/emacsclient",
        "/snap/bin/emacsclient",
    ]
    for path in candidates:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            _emacsclient = path
            return _emacsclient
    found = shutil.which("emacsclient")
    if found:
        _emacsclient = found
        return _emacsclient
    return None


def read_message():
    raw_length = sys.stdin.buffer.read(4)
    if len(raw_length) < 4:
        return None
    length = struct.unpack("<I", raw_length)[0]
    return json.loads(sys.stdin.buffer.read(length))


def send_message(message):
    encoded = json.dumps(message).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(encoded)))
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.flush()


def main():
    message = read_message()
    if not message or "url" not in message:
        send_message({"error": "No URL provided"})
        return
    emacsclient = find_emacsclient()
    if not emacsclient:
        send_message({"error": "emacsclient not found"})
        return
    url = message["url"].replace("\\", "\\\\").replace('"', '\\"')
    elisp = f'(progn (eww "{url}") (raise-frame))'
    result = subprocess.run(
        [emacsclient, "-e", elisp],
        capture_output=True,
    )
    if result.returncode == 0:
        send_message({"success": True})
    else:
        send_message({"error": result.stderr.decode()})


if __name__ == "__main__":
    main()
