{
  "manifest_version": 3,
  "name": "Open in eww",
  "version": "1.0",
  "description": "Open the current page or a link in Emacs eww browser",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open in eww",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
