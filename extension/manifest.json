{
  "manifest_version": 3,
  "name": "Open in eww",
  "version": "1.1",
  "description": "Connect Emacs to Chrome and open pages in eww",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging", "scripting"],
  "host_permissions": [
    "https://annas-archive.gl/*",
    "https://annas-archive.pk/*",
    "https://annas-archive.gd/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open in eww",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
